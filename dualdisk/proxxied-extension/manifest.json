{
  "manifest_version": 3,
  "name": "Proxxied Pair Importer",
  "version": "1.0.0",
  "description": "Imports dualdisk front/back MTG land pairs into a proxxied.com project.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://proxxied.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://proxxied.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
