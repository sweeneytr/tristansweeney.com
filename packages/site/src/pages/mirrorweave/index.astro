---
import Layout from "#layouts/Minimal.astro";
import { Mirrorweave } from "@aelar/mirrorweave";
---

<Layout
  title="Mirrorweave"
  pageTitle="Mirrorweave | Tristan Sweeney"
  description="Lorwyn 360 cube cards paired with Shadowmoor and Eventide counterparts, to print as double-faced cards"
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,900&family=Karla:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
  />
  <Mirrorweave client:only="react" basename="/mirrorweave" />
</Layout>
