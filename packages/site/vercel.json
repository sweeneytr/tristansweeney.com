{
  "headers": [
    {
      "source": "/v1/generate/resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=TristanSweeneyResume.pdf"
        }
      ]
    },
    {
      "source": "/mirrorweave-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mirrorweave/:path+",
      "destination": "/mirrorweave/"
    }
  ]
}
